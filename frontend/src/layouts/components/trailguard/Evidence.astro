---
import { evidenceItems } from "@/data/trailguard";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section id="bukti" class="section scroll-mt-24">
  <div class="container">
    <SectionHeading
      badge="Bukti LinuxONE"
      title='Juri menilai lewat <strong>screenshot</strong>'
      subtitle="Semua bukti bertanda jam/tanggal & hostname, disimpan di evidence/. Tanpa bukti, sebuah fitur tidak ditulis sebagai klaim."
    />

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        evidenceItems.map((e) => (
          <div class="flex items-start gap-3 rounded-2xl border border-border bg-light p-5">
            <span class="font-secondary text-h4 font-bold text-primary/60">
              {e.id}
            </span>
            <p class="mt-1 text-xs leading-5 text-text">{e.title}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-border bg-light/60 p-7">
        <div class="mb-3 flex items-center gap-3">
          <Icon name="terminal" class="size-5 text-primary" />
          <h3 class="font-secondary text-h6 font-bold text-white">
            make evidence
          </h3>
        </div>
        <p class="text-sm leading-6 text-text">
          Mengumpulkan info sistem (uname, lscpu, free, df, versi paket ML,
          container, metrik & benchmark terakhir) ke{" "}
          <code class="font-mono text-xs text-text-light">evidence/system_info.txt</code>{" "}
          — lalu screenshot layarnya.
        </p>
      </div>

      <div class="rounded-2xl border border-primary/30 bg-primary/5 p-7">
        <div class="mb-3 flex items-center gap-3">
          <Icon name="shield" class="size-5 text-primary" />
          <h3 class="font-secondary text-h6 font-bold text-white">
            Bukti &gt; klaim
          </h3>
        </div>
        <p class="text-sm leading-6 text-text">
          Fitur yang tidak bisa ditunjukkan di screenshot atau video tidak
          ditulis sebagai klaim. SHAP hanya bila{" "}
          <code class="font-mono text-xs text-primary">
            evidence/shap_pyarrow_check.txt
          </code>{" "}
          menunjukkan <code class="font-mono text-xs">[OK] shap</code>.
        </p>
      </div>
    </div>
  </div>
</section>
