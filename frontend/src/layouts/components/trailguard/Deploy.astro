---
import { deploy } from "@/data/trailguard";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

const commands = [
  { c: "bash scripts/00_check_env.sh", d: "cek arsitektur & tools (harap s390x)" },
  { c: "bash scripts/01_setup_env.sh", d: "venv + dependensi" },
  { c: "make toy", d: "data tiruan + pipeline penuh (< 1 menit)" },
  { c: "make shap-check", d: "go/no-go SHAP & pyarrow" },
  { c: "make api", d: "dashboard di :8000" },
  { c: "make container", d: "build & jalankan di podman/docker" },
];
---

<section id="deploy" class="section scroll-mt-24">
  <div class="container">
    <SectionHeading
      badge="Deployment · IBM LinuxONE"
      title='Berjalan di <strong>s390x</strong>, terkontainer'
      subtitle="Seluruh pipeline dan dashboard berjalan di dalam instance LinuxONE. Landing statis ini disajikan nginx di VM."
    />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        deploy.map((d) => (
          <article class="flex flex-col rounded-2xl border border-border bg-light p-6">
            <span class="mb-4 flex size-11 items-center justify-center rounded-xl bg-primary/12 text-primary">
              <Icon name={d.icon} class="size-5.5" />
            </span>
            <h3 class="mb-2 font-secondary text-h6 font-bold text-white">
              {d.title}
            </h3>
            <p class="text-sm leading-6 text-text">{d.desc}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <div class="overflow-hidden rounded-3xl border border-border bg-body">
        <div class="flex items-center gap-2 border-b border-border bg-light px-5 py-3">
          <Icon name="terminal" class="size-4 text-primary" />
          <span class="font-mono text-xs text-text-dark">di VM LinuxONE</span>
        </div>
        <div class="divide-y divide-border/60">
          {
            commands.map((cmd) => (
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3">
                <code class="font-mono text-xs text-primary">$ {cmd.c}</code>
                <span class="text-xs text-text-dark">— {cmd.d}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col justify-center rounded-3xl border border-border bg-light p-8">
        <h3 class="mb-4 font-secondary text-h5 font-bold text-white">
          Kenapa aman untuk privasi
        </h3>
        <ul class="space-y-4 text-sm text-text">
          <li class="flex gap-3">
            <Icon name="lock" class="mt-0.5 size-5 shrink-0 text-primary" />
            <span>
              Kunci HMAC di <code class="font-mono text-xs">.env</code>; data
              mentah & kunci <strong>tidak</strong> ikut ke dalam image container.
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="shield" class="mt-0.5 size-5 shrink-0 text-primary" />
            <span>
              Identitas di-hash saat ingestion (HMAC-SHA256, 16 hex) — dashboard
              hanya menampilkan ID ter-pseudonim.
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="server" class="mt-0.5 size-5 shrink-0 text-primary" />
            <span>
              Model di-<em>pickle</em> & dimuat di arsitektur yang sama
              (LinuxONE) — latih dan muat di mesin yang sama.
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
